<!DOCTYPE html>
<html>
<head>
    <title>Sagar Chauhan - Portfolio</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="hacker-theme">
    <div class="terminal-window">
        <header>
            <div class="container">
                <h1 class="glitch" data-text="Sagar Chauhan">Sagar Chauhan</h1>
                <p><i class="fas fa-map-marker-alt"></i> Vadodara, Gujarat, India</p>
                <div class="contact">
                    <a href="https://sagarchauhansk.github.io" target="_blank"><i class="fab fa-github"></i> GitHub</a>
                </div>
            </div>
        </header>

        <main class="container">
            <section class="quote fade-in">
                <p>
                    <span role="img" aria-label="Brain">🧠</span> Don't assess my worth by my academic background, but rather by the tangible skills <span role="img" aria-label="Tools">🛠️</span> I possess.
                </p>
                <div class="button-container">
                    <a href="#" class="btn">View Projects</a>
                    <a href="#" class="btn">Download Resume</a>
                </div>
            </section>

            <section class="skills fade-in">
                <h2>>_ <i class="fas fa-terminal"></i> Skills & Expertise</h2>
                <div class="skills-grid">
                    <div class="card fade-in">
                        <h3>Graphics & Web Design</h3>
                        <p>Adobe Illustrator, Photoshop, UI/UX Principles</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Social Media Marketing</h3>
                        <p>Strategy, Execution & Analytics</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Operating Systems</h3>
                        <p>Windows Server, Linux (CentOS, Ubuntu), VMware vSphere</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Networking</h3>
                        <p>TCP/IP, DNS, DHCP, VPN, Firewall Configuration</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Cloud Computing</h3>
                        <p>AWS (EC2, S3, IAM), Azure (VMs, Storage)</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Cybersecurity</h3>
                        <p>IDS/IPS, Penetration Testing</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Web Development</h3>
                        <p>React, Angular, jQuery, Spring, Node.js</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Database Management</h3>
                        <p>MySQL, PostgreSQL, MongoDB</p>
                    </div>
                </div>
            </section>

            <section class="experience fade-in">
                <h2>>_ <i class="fas fa-briefcase"></i> Professional Experience</h2>
                <div class="experience-list">
                    <div class="card fade-in">
                        <h3>Khodaldham Trading</h3>
                        <p class="role">Accountant & Supervisor</p>
                        <p class="duration">Feb 2022 - Nov 2024</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Bufab India Pvt. Ltd.</h3>
                        <p class="role">QC Dept.</p>
                        <p class="duration">May 2020 - Jan 2022</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Office Beacon</h3>
                        <p class="role">Web Graphics Designer</p>
                        <p class="duration">Nov 2019 - Mar 2020</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Concentrix</h3>
                        <p class="role">SEO Content Development</p>
                        <p class="duration">Jun 2019 - Sep 2019</p>
                    </div>
                    <div class="card fade-in">
                        <h3>KV ONGC, Baroda</h3>
                        <p class="role">Back Office Assistant</p>
                        <p class="duration">Dec 2018 - Jun 2019</p>
                    </div>
                </div>
            </section>

            <section class="languages fade-in">
                <h2>>_ <i class="fas fa-language"></i> Languages</h2>
                <p>Gujarati, Hindi, English (Read, Write, Speak)</p>
            </section>

            <section class="interests fade-in">
                <h2>>_ <i class="fas fa-heart"></i> Interests</h2>
                <div class="interests-grid">
                    <div class="card fade-in">Open-Source Contributions</div>
                    <div class="card fade-in">Competitive Programming</div>
                    <div class="card fade-in">Chess</div>
                    <div class="card fade-in">Photography</div>
                    <div class="card fade-in">Digital Illustration</div>
                    <div class="card fade-in">Calligraphy</div>
                    <div class="card fade-in">Movies</div>
                    <div class="card fade-in">Reading</div>
                </div>
            </section>

            <section class="activities fade-in">
                <h2>>_ <i class="fas fa-running"></i> Activities</h2>
                <p>Watching Shows, Movies & Documentaries, Traveling on Weekends</p>
            </section>

            <section class="education fade-in">
                <h2>>_ <i class="fas fa-graduation-cap"></i> Education</h2>
                <div class="education-list">
                    <div class="card fade-in">
                        <h3>Industrial Training Institute (ITI)</h3>
                        <p>Computer Operator & Programming Assistant (COPA) - 69.75%</p>
                    </div>
                    <div class="card fade-in">
                        <h3>Panchasheel High School</h3>
                        <p>SSC - 49%</p>
                    </div>
                </div>
            </section>
        </main>

        <footer>
            <div class="container">
                <p>&copy; <%= new Date().getFullYear() %> Sagar Chauhan</p>
            </div>
        </footer>
    </div>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const fadeIns = document.querySelectorAll('.fade-in');
            const observer = new IntersectionObserver(entries => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('active');
                        observer.unobserve(entry.target);
                    }
                });
            });
            fadeIns.forEach(fadeIn => {
                observer.observe(fadeIn);
            });
        });
    </script>
</body>
</html>
